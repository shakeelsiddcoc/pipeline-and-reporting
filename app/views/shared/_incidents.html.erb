<%# alerts: Alert relation; detail: show detail + sample columns %>
<% span = @week_end - @week_start %>
<div class="wrap"><table>
  <thead><tr>
    <th>Detected</th><th>Severity</th><th>Check</th><th>Partner</th><th class="num">Affected</th>
    <th>Active during week
      <div class="days"><% 7.times do |d| %><span><%= (@week_start + d.days).strftime("%a")[0, 2] %></span><% end %></div></th>
    <th>Resolved</th>
    <% if detail %><th>Detail</th><th>Sample IDs</th><% end %>
  </tr></thead>
  <tbody>
    <% alerts.each do |a| %>
      <% from = ((a.detected_at - @week_start) / span * 100).clamp(0, 100)
         to = (((a.resolved_at || @week_end) - @week_start) / span * 100).clamp(0, 100) %>
      <tr>
        <td class="num"><%= a.detected_at.strftime("%a %m-%d %H:%M") %></td>
        <td><%= severity_badge(a.severity) %></td>
        <td><%= a.check_name.humanize %></td>
        <td><%= a.partner_id %> <span class="muted"><%= @partners[a.partner_id] %></span></td>
        <td class="num"><%= a.affected_count %></td>
        <td><div class="tl" role="img" aria-label="active from <%= a.detected_at.strftime('%a %H:%M') %> to <%= a.resolved_at&.strftime('%a %H:%M') || 'end of data' %>">
          <span class="st-<%= ChartsHelper::SEVERITY_STATUS[a.severity] %>" style="left:<%= from.round(2) %>%; width:<%= (to - from).round(2) %>%"></span></div></td>
        <td class="num"><%= a.resolved_at ? a.resolved_at.strftime("%a %m-%d %H:%M") : "Open" %></td>
        <% if detail %>
          <td><%= a.detail %></td><td><code><%= Array(a.sample_ids).join(" ") %></code></td>
        <% end %>
      </tr>
    <% end %>
  </tbody>
</table></div>
