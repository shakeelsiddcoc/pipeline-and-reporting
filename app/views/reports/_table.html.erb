<%# rows: array of hashes for one day; cols: columns to show; label: header for partner column %>
<% if rows.empty? %>
  <div class="card empty">No data for this day.</div>
<% else %>
  <div class="card table-card"><div class="wrap">
    <table>
      <thead><tr><th><%= label %></th><% cols.each do |c| %><th class="num"><%= c.humanize %></th><% end %></tr></thead>
      <tbody>
        <% rows.each do |r| %>
          <tr class="<%= 'total' if r['partner_id'] == 'ALL' %>">
            <td><%= r["partner_id"] == "ALL" ? "All" : r["partner_id"] %> <span class="muted"><%= @partners[r["partner_id"]] %></span></td>
            <% cols.each do |c| %><td class="num"><%= fmt.(c, r[c]) %></td><% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div></div>
<% end %>
